{
  "manifest_version": 3,
  "name": "SIA UNAL Pro",
  "description": "SIA UNAL Pro es una extensión de navegador que mejora el Sistema de Información Académica de la Universidad Nacional de Colombia.",
  "version": "1.0.32",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.sia.unal.edu.co/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "css/box.css",
        "css/required-grade.css",
        "css/asignaturas.css",
        "css/creditos.css",
        "css/avance.css"
      ]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}